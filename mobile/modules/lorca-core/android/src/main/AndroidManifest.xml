<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- The app installs its own releases (Updater): with the second, from Android 12 without asking. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
  <application>
    <!-- Ahead of expo-notifications' own service (priority -1): pushes here are ciphertext. -->
    <service android:name=".PushService" android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <receiver android:name=".UpdateReceiver" android:exported="false" />
  </application>
</manifest>

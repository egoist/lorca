{
  "name": "lorca-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "secrets": {
    // The token the Runner sends; set it in Settings → Coding Agents with the Worker's address.
    "required": ["LORCA_TOKEN"],
  },
  "durable_objects": {
    "bindings": [{ "name": "SANDBOX", "class_name": "LorcaSandbox" }],
  },
  "containers": [
    {
      "class_name": "LorcaSandbox",
      "scheduling_policy": "durable_object",
      "images": { "sandbox": { "dockerfile": "./Dockerfile" } },
    },
  ],
  "exports": {
    "LorcaSandbox": { "type": "durable-object", "storage": "sqlite" },
  },
  "observability": { "enabled": true },
}

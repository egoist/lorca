# Copy to .env (gitignored). Bun loads it for `bun run dev` and `bun run relay`, and the relay
# reads these variables. Keep the key files outside the repo, e.g. ~/.config/lorca-relay/.

# Pushes to iPhones: the APNs key from developer.apple.com > Keys (Apple Push Notifications
# service, team scoped, sandbox and production). The 10-character key id is in the file name.
LORCA_RELAY_APNS_TEAM_ID=
LORCA_RELAY_APNS_KEY=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
LORCA_RELAY_APNS_KEY_ID=
# The phone app's bundle id; this is the default.
#LORCA_RELAY_APNS_TOPIC=app.lorca

# Pushes to Android phones: Firebase console > Project settings > Service accounts > Generate new private key.
#LORCA_RELAY_FCM_SERVICE_ACCOUNT=/absolute/path/to/fcm-service-account.json

# Signs the relay's bearer tokens. Random per boot when unset, which logs every Device out on restart.
#LORCA_RELAY_SECRET=

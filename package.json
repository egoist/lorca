{
  "name": "tinybot",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "cli": "cargo run -q -p tinybot -- serve",
    "reset": "bun run scripts/reset.ts",
    "relay": "cargo run -q -p tinybot-relay --",
    "web": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:deploy": "bun run --cwd web deploy"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}

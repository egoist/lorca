{
  "name": "lorca",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "cli": "cargo run -q -p lorca -- serve",
    "reset": "bun run scripts/reset.ts",
    "relay": "cargo run -q -p lorca-relay -- --bind 0.0.0.0:8787 --db target/lorca-relay.db",
    "web": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:deploy": "bun run --cwd web deploy",
    "mobile:dev": "bun run scripts/mobile.ts",
    "mobile:phone": "bun run scripts/mobile.ts --phone",
    "mobile": "bun run --cwd mobile start",
    "mobile:ios": "bun run --cwd mobile ios",
    "mobile:android": "bun run --cwd mobile android"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
